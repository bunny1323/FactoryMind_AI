# ─── Vector DB ──────────────────────────────────────────────────────────────────
VECTOR_BACKEND=qdrant
QDRANT_URL=https://<your-cluster-url>.qdrant.tech:6333
QDRANT_API_KEY=<your-qdrant-api-key>

# ─── Embeddings & Reranking ───────────────────────────────────────────────────
EMBEDDING_BACKEND=fastembed
SPARSE_EMBEDDING_BACKEND=fastembed
RERANKER_BACKEND=cross_encoder
RERANKER_MODEL=BAAI/bge-reranker-base

# ─── LLM Provider Configuration ──────────────────────────────────────────────
# Options: gemini | openrouter | ollama | mock
LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=openrouter

# --- Primary: Gemini (Google AI Studio)
# Get key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=place_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Fallback: OpenRouter (Qwen 2.5 30B / Instruct)
# Get key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=<your-openrouter-api-key>
OPENROUTER_MODEL=qwen/qwen-2.5-30b-a3b-instruct

# --- Optional: Local Ollama (offline)
# Install: https://ollama.ai then run: ollama pull qwen2.5:7b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ─── Graph Database Settings ─────────────────────────────────────────────────
# Neo4j is DISABLED — replaced with lightweight in-memory graph.
# No external graph database is needed.
